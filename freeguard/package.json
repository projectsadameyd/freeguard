{
  "name": "usccb-freeguard",
  "version": "2.0.0",
  "description": "USCCB:free-Guard v2 — Enterprise AI-powered Discord moderation bot by EchoBastion Group",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "keepalive": "node keepalive.js",
    "logs": "node readlog.js",
    "logs:files": "node readlog.js --files",
    "health": "curl -s http://localhost:3000/health | node -e \"process.stdin.pipe(process.stdout)\""
  },
  "keywords": [
    "discord",
    "moderation",
    "ai",
    "voice",
    "nsfw",
    "freeguard",
    "ebs-group"
  ],
  "author": "EchoBastion Group",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.16.3",
    "@discordjs/voice": "^0.18.0",
    "opusscript": "^0.1.1",
    "tweetnacl": "^1.0.3",
    "dotenv": "^16.4.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/echo-bastion/freeguard"
  }
}
